{
  "name": "ajrwebdesign/ajr-starter-core",
  "description": "Core functionality scaffold for AJR Web Design client builds. Settings-driven: nothing it does is hardcoded.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "10up/wp_mock": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "AJR\\StarterCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AJR\\StarterCore\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpcs": "./vendor/bin/phpcs",
    "phpcbf": "./vendor/bin/phpcbf",
    "test": "./vendor/bin/phpunit"
  }
}
